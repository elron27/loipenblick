# Kopieren nach .env und Werte anpassen. .env kommt nie ins Repository (B4).

POSTGRES_USER=loipen
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=loipen

LOIPEN_DATABASE_URL=postgresql+psycopg://loipen:bitte-aendern@db:5432/loipen
LOIPEN_USER_AGENT=LoipenBot/0.1 (privat; deine-mail@example.com)
LOIPEN_REQUEST_DELAY_S=5

# Port der Vorschau im Heimnetz: http://<NAS-IP>:8080
VORSCHAU_PORT=8080

# Ordner fuer den taeglichen Dump; muss im NAS-Backup enthalten sein (B14)
BACKUP_DIR=./backup

# Push-Alarme, z. B. https://ntfy.sh/dein-geheimes-thema
LOIPEN_NTFY_URL=

# ---------- Livegang (docs/livegang.md). Leer lassen = nur Vorschau im Heimnetz. ----------
# Upload-Ziel (B8): sftp://benutzer@host:22/pfad/zum/webordner oder ftps://benutzer@host/pfad
LOIPEN_UPLOAD_URL=
LOIPEN_UPLOAD_PASSWORT=
# statt Passwort: privater Schluessel im Ordner geheim/ neben der docker-compose.yml
# LOIPEN_UPLOAD_SCHLUESSEL=/app/geheim/id_ed25519
# Fingerabdruck des Servers fuer SFTP: einmal "ssh-keyscan -p 22 host > geheim/known_hosts" und pruefen
# LOIPEN_UPLOAD_KNOWN_HOSTS=/app/geheim/known_hosts
# Oeffentliche Adresse, zur Kontrolle nach dem Upload (B21)
LOIPEN_OEFFENTLICHE_URL=
# Heartbeat nach jedem erfolgreichen Upload (B22), z. B. https://hc-ping.com/<uuid>
LOIPEN_HEARTBEAT_URL=
# Erst nach der Freigabe auf true: Suchmaschinen duerfen die Seite aufnehmen
LOIPEN_OEFFENTLICH=false

# Impressum (B6, Paragraf 18 MStV). Ohne diese drei Angaben laedt das NAS nichts hoch.
LOIPEN_IMPRESSUM_NAME=
# Zeilen mit | trennen, z. B. Musterstrasse 1|83700 Rottach-Egern
LOIPEN_IMPRESSUM_ANSCHRIFT=
LOIPEN_IMPRESSUM_EMAIL=
# Webhoster fuer die Datenschutzerklaerung: Firma und Anschrift, wie im Impressum des Hosters
LOIPEN_HOSTER=
# Eigener Datenschutztext (HTML-Ausschnitt) statt der Vorlage
# LOIPEN_DATENSCHUTZ_DATEI=/app/geheim/datenschutz.html
