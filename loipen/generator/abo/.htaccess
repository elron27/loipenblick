# E-Mail-Abo (E-18): nur die fuenf Skripte sind von aussen erreichbar.
Options -Indexes
<IfModule mod_authz_core.c>
  Require all denied
  <FilesMatch "^(anmelden|bestaetigen|abmelden|melden|export)\.php$">
    Require all granted
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <FilesMatch "^(anmelden|bestaetigen|abmelden|melden|export)\.php$">
    Allow from all
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  Header always set Cache-Control "no-store"
  Header always set X-Robots-Tag "noindex"
</IfModule>
