<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
{% if base %}<base href="{{ base }}">
{% endif %}<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ kopf_titel or (titel ~ " · Loipenblick") }}</title>
{% if beschreibung %}<meta name="description" content="{{ beschreibung }}">
{% endif %}{% if not oeffentlich %}<meta name="robots" content="noindex, nofollow">
{% elif robots %}<meta name="robots" content="{{ robots }}">
{% endif %}{% if canonical %}<link rel="canonical" href="{{ canonical }}">
{% endif %}{% for j in jsonld or [] %}<script type="application/ld+json">{{ j }}</script>
{% endfor %}<meta name="theme-color" content="#06111a" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#eaf3f9" media="(prefers-color-scheme: light)">
<link rel="icon" href="icon-192.png" type="image/png">
<link rel="stylesheet" href="app.css?v={{ stand }}">
</head>
<body class="textseite{% if seitenart %} {{ seitenart }}{% endif %}">
{% if not oeffentlich %}{{ testband }}
{% endif %}<header class="top">
  <div class="wrap in">
    <a class="logo" href="./#/" aria-label="Loipenblick, Startseite"><i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18c4-9 6-9 9-3s6 3 9-8"/></svg></i><span>Loipenblick</span></a>
    <nav class="tabs" aria-label="Seiten">
      <a href="./#/">Heute</a>
      <a href="./#/karte">Karte</a>
      <a href="./#/loipen">Loipen</a>
    </nav>
{% if spenden %}    <a class="spenden-kopf" href="hinweise.html#unterstuetzen" title="Loipenblick unterstützen"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.5s-7.5-4.6-9.2-9.4C1.6 7.6 3.9 4.5 7.2 4.5c2 0 3.5 1.1 4.8 2.8 1.3-1.7 2.8-2.8 4.8-2.8 3.3 0 5.6 3.1 4.4 6.6-1.7 4.8-9.2 9.4-9.2 9.4z"/></svg><span>Unterstützen</span></a>
{% endif %}  </div>
</header>
<main id="view" class="wrap text">
{% if krumen %}<nav class="krumen fine" aria-label="Brotkrumen">{% for name, pfad in krumen %}{% if not loop.last %}<a href="{{ pfad }}">{{ name }}</a> › {% else %}<span aria-current="page">{{ name }}</span>{% endif %}{% endfor %}</nav>
{% endif %}<h1>{{ titel }}</h1>
{{ inhalt }}
</main>
<footer class="foot">
  <div class="wrap">
    <p><strong>Alle Angaben ohne Gewähr.</strong> Maßgeblich ist immer die Quelle vor Ort.</p>
    <p class="fine rechtlich"><a href="gebiete/">Alle Gebiete</a> · <a href="hinweise.html">Hinweise und Betreiber</a> · <a href="impressum.html">Impressum</a> · <a href="datenschutz.html">Datenschutz</a></p>
{% if spenden %}    <p class="fine spenden">Loipenblick ist kostenlos und ohne Werbung. Wer mag, kann es <a href="{{ spenden.url }}" rel="noopener noreferrer">über {{ spenden.anbieter }} unterstützen</a>.</p>
{% endif %}  </div>
</footer>
</body>
</html>
